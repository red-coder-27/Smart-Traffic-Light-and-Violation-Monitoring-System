generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAFFIC_POLICE
  CITIZEN
}

enum IntersectionStatus {
  ACTIVE
  INACTIVE
}

enum SignalStatus {
  RED
  YELLOW
  GREEN
}

enum SignalDirection {
  NORTH
  EAST
  SOUTH
  WEST
}

enum EmergencyVehicleType {
  AMBULANCE
  FIRE_ENGINE
  POLICE_VEHICLE
}

enum EmergencyPriorityStatus {
  REQUESTED
  ACTIVE
  COMPLETED
  CANCELLED
  TIMED_OUT
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChallanStatus {
  UNPAID
  PAID
  CANCELLED
}

model Violation {
  id               String        @id @default(uuid())
  occurredAt       DateTime
  intersectionId   String
  trafficSignalId  String
  violationType    String
  description      String?
  recordedByUserId String
  violatingUserId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  intersection  Intersection  @relation(fields: [intersectionId], references: [id], onDelete: Restrict)
  trafficSignal TrafficSignal @relation(fields: [trafficSignalId], references: [id], onDelete: Restrict)
  recordedBy    User          @relation("RecordedViolations", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  violatingUser User?         @relation("ViolatingUserViolations", fields: [violatingUserId], references: [id], onDelete: SetNull)
  evidence      Evidence[]
  challan       Challan?
  appeal        Appeal?

  @@index([occurredAt])
  @@index([intersectionId])
  @@index([trafficSignalId])
  @@index([recordedByUserId])
  @@index([violatingUserId])
  @@map("violations")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CITIZEN)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile UserProfile?
  signalConfigChanges SignalConfigHistory[]
  requestedEmergencyPriorities EmergencyPriorityRequest[] @relation("RequestedEmergencyPriorities")
  controlledEmergencyPriorities EmergencyPriorityRequest[] @relation("ControlledEmergencyPriorities")
  recordedViolations Violation[] @relation("RecordedViolations")
  violatingViolations Violation[] @relation("ViolatingUserViolations")
  uploadedEvidence Evidence[]
  challans Challan[] @relation("CitizenChallans")
  appeals Appeal[] @relation("CitizenAppeals")

  @@map("users")
}

model Intersection {
  id        String             @id @default(uuid())
  name      String
  location  String
  latitude  Float?
  longitude Float?
  status    IntersectionStatus @default(ACTIVE)
  signals   TrafficSignal[]
  violations Violation[]
  emergencyPriorities EmergencyPriorityRequest[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([name, location])
  @@map("intersections")
}

model TrafficSignal {
  id               String                 @id @default(uuid())
  intersectionId   String
  intersection     Intersection           @relation(fields: [intersectionId], references: [id], onDelete: Cascade)
  direction        SignalDirection?
  status           SignalStatus           @default(RED)
  greenDuration    Int                    @default(30)
  yellowDuration   Int                    @default(5)
  redDuration      Int                    @default(30)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  configHistory    SignalConfigHistory[]
  violations       Violation[]
  emergencyPriorities EmergencyPriorityRequest[]

  @@unique([intersectionId, direction])
  @@map("traffic_signals")
}

model EmergencyPriorityRequest {
  id                 String                  @id @default(uuid())
  intersectionId     String
  signalId           String
  direction          SignalDirection
  vehicleType        EmergencyVehicleType
  status             EmergencyPriorityStatus @default(REQUESTED)
  requestedByUserId  String
  controlledByUserId String?
  previousStatuses   String?
  restorationError   String?
  requestedAt        DateTime                @default(now())
  validatedAt        DateTime?
  activatedAt        DateTime?
  endedAt            DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  intersection Intersection @relation(fields: [intersectionId], references: [id], onDelete: Restrict)
  signal       TrafficSignal @relation(fields: [signalId], references: [id], onDelete: Restrict)
  requestedBy  User          @relation("RequestedEmergencyPriorities", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  controlledBy User?         @relation("ControlledEmergencyPriorities", fields: [controlledByUserId], references: [id], onDelete: SetNull)

  @@index([intersectionId, status])
  @@index([requestedAt])
  @@map("emergency_priority_requests")
}

model SignalConfigHistory {
  id              String       @id @default(uuid())
  signalId        String
  signal          TrafficSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  previousConfig  String?
  newConfig       String
  changedByUserId String?
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@map("signal_config_history")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  address     String?
  city        String?
  state       String?
  postalCode  String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Evidence {
  id           String    @id @default(uuid())
  violationId  String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String    @unique
  uploaderId   String
  createdAt    DateTime  @default(now())

  violation    Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  uploader     User      @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([violationId])
  @@index([uploaderId])
  @@index([createdAt])
  @@map("evidence")
}

model Challan {
  id               String        @id @default(uuid())
  challanNumber    String        @unique
  violationId      String        @unique
  citizenId        String
  amount           Float
  status           ChallanStatus @default(UNPAID)
  paidAt           DateTime?
  paymentReference String?
  paymentMethod    String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  violation        Violation     @relation(fields: [violationId], references: [id], onDelete: Cascade)
  citizen          User          @relation("CitizenChallans", fields: [citizenId], references: [id], onDelete: Restrict)
  transactions     PaymentTransaction[]

  @@index([citizenId])
  @@index([status])
  @@map("challans")
}

model PaymentTransaction {
  id             String   @id @default(uuid())
  challanId      String
  amount         Float
  status         String
  reference      String   @unique
  paymentMethod  String
  failureReason  String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  challan        Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)

  @@index([challanId])
  @@map("payment_transactions")
}

model Appeal {
  id          String       @id @default(uuid())
  violationId String       @unique
  citizenId   String
  reason      String
  status      AppealStatus @default(PENDING)
  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  violation   Violation    @relation(fields: [violationId], references: [id], onDelete: Cascade)
  citizen     User         @relation("CitizenAppeals", fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([citizenId])
  @@index([status])
  @@map("appeals")
}
